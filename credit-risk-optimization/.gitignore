data/cleaned/*
!data/cleaned/.gitkeep
data/exports/*
!data/exports/.gitkeep
*.csv
*.tsv
*.parquet
*.gz
*.zip

# OS artifacts
.DS_Store
Thumbs.db

# Agent workspace tooling
.agent/
